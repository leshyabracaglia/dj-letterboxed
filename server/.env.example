# Postgres connection string (standard TCP DSN, not Neon's HTTP driver)
DATABASE_URL=postgres://beatboxd:beatboxd@localhost:5433/beatboxd?sslmode=disable

PORT=8080

# Clerk — JWKS URL and issuer for verifying session JWTs (from your Clerk
# instance's "API Keys" / "JWT templates" settings), plus the secret key
# and webhook signing secret used by the lazy-user-creation fallback and
# the /api/webhooks/clerk endpoint respectively.
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Spotify client-credentials (for djs.searchSpotify)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google Places API (New) key, for venue search on the review form
# (Google Cloud console -> APIs & Services -> enable "Places API (New)" ->
# Credentials). Optional: without it place search is off and venues can
# only be typed in by hand.
GOOGLE_PLACES_API_KEY=
