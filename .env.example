# Clerk publishable key (client-side only). Server-side Clerk config
# (secret key, webhook signing secret, JWKS URL/issuer) lives in
# server/.env now — see server/.env.example.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Base URL the Expo client uses to reach the Go API.
# Local dev: http://<your-machine's-LAN-IP>:8080 (see server/README.md /
# server/docker-compose.yml to run it locally).
# Production: https://api.beatboxd.com
EXPO_PUBLIC_API_URL=
