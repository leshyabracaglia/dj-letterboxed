# Clerk publishable key (client-side only). Server-side Clerk config
# (secret key, webhook signing secret, JWKS URL/issuer) lives in
# server/.env now — see server/.env.example.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Base URL the Expo client uses to reach the Go API in production builds
# (https://api.beatboxd.com). In dev this is ignored: lib/api/client.ts
# auto-targets port 8080 on the machine serving the Metro bundle, so a changed
# LAN IP needs no edit here.
EXPO_PUBLIC_API_URL=
