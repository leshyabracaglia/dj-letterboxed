{
  "name": "beatboxd",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@clerk/expo": "^4.5.2",
    "@expo-google-fonts/jersey-10": "^0.4.1",
    "@expo-google-fonts/permanent-marker": "^0.4.0",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/checkbox": "^1.5.2",
    "@tanstack/react-query": "^5.101.4",
    "expo": "^58.0.0",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.21",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "html2canvas-pro": "^2.4.5",
    "nativewind": "^4.2.7",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.64.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~58.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "swagger2openapi": "^7.0.8",
    "typescript": "~6.0.3",
    "vercel": "^59.3.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev:api": "docker compose -f server/docker-compose.yml up --build",
    "dev:app": "expo start",
    "dev": "bash scripts/dev-windows.sh",
    "dev:concurrent": "concurrently \"npm:dev:api\" \"npm:dev:app\"",
    "db:migrate": "cd server && make migrate-up",
    "db:seed": "cd server && make seed",
    "db:reset": "cd server && make reset-db",
    "db:prod": "bash scripts/prod-db.sh tunnel",
    "db:prod:query": "bash scripts/prod-db.sh query",
    "codegen:api-types": "cd server && make openapi && cd .. && bash scripts/generate-api-types.sh",
    "test:e2e": "playwright test",
    "lint": "expo lint",
    "format": "prettier --write app components lib e2e test",
    "format:check": "prettier --check app components lib e2e test",
    "test": "jest",
    "dev:tunnel": "bash scripts/dev-tunnel.sh"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/e2e/",
      "<rootDir>/server/",
      "<rootDir>/.agents/"
    ]
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
