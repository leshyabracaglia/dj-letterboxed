  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev:api": "docker compose -f server/docker-compose.yml up",
    "dev:app": "expo start",
    "dev": "bash scripts/dev-windows.sh",
    "dev:concurrent": "concurrently \"npm:dev:api\" \"npm:dev:app\"",
